# Kopier til oauth.env (gitignorert) og fyll inn. Se «Secrets» i k8s/README.md.

# Appregistreringen i Entra ID. Bare client_secret er hemmelig.
RR_OAUTH_TENANT_ID=
RR_OAUTH_CLIENT_ID=
RR_OAUTH_CLIENT_SECRET=

# Personal access token, lest av conf/provisioning/schemasources/*.yaml.
RR_AIRTABLE_ACCESS_TOKEN=
