# Legitimasjonen til Postgres. Kopier til postgres.env og fyll inn passordene.
#
#   cp postgres.env.example postgres.env
#   task gcp:db-secret
#
# postgres.env er gitignorert og skal ikke sjekkes inn.
#
# Oppgaven lager to Secrets av denne filen: secret-postgres i ns-database, som
# databasen selv leser, og secret-grafana-slo-db i ns-grafana-slo, med
# tilkoblingsstrengen appen leser.
#
# Generer passord som ikke trenger siteres noe sted:
#
#   openssl rand -hex 24

# Superbrukeren i instansen. Brukes av «task gcp:db-psql» og til å lage
# databaser og roller for nye apper. Ikke gi den til en applikasjon.
POSTGRES_PASSWORD=

# Appens egen database og rolle. Lages ved første initialisering av volumet,
# av k8s/postgres/initdb/10-create-app-database.sh.
APP_DB_NAME=grafana_slo
APP_DB_USER=grafana_slo
APP_DB_PASSWORD=
